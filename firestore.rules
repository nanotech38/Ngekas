rules_version = '2';

// Fondasi rules untuk model owner & staff:
// - /users/{uid}      -> profil workspace tiap akun (role, ownerId).
// - /workspaces/{ownerId}/... -> data bisnis milik 1 owner, dibaca/ditulis
//   oleh owner itu sendiri ATAU staff yang ownerId-nya cocok.
//
// Baseline permission: staff boleh create+read transaksi/kategori, tapi
// cuma owner yang boleh update/delete. Perhalus lagi begitu fitur
// undang-staff & UI pembatasannya sudah dibangun.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOfWorkspace(ownerId) {
      return isSignedIn() && myProfile().ownerId == ownerId;
    }

    function isOwnerRole() {
      return myProfile().role == 'owner';
    }

    // Profil user: dibaca oleh uid yang sama ATAU owner workspace-nya
    // (buat layar "Kelola Orang" — owner perlu lihat daftar staff-nya).
    // create/update dibatasi ke uid yang sama (tiap orang cuma bisa nulis
    // profil sendiri). delete dibolehkan buat owner workspace-nya (owner
    // "mengeluarkan" orang) — otomatis termasuk owner hapus profil sendiri
    // (ownerId == uid dia sendiri), tapi tidak ada tombol buat itu di UI.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || resource.data.ownerId == request.auth.uid);
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Kode undangan — penanda publik (readable siapa saja yang login) buat
    // validasi "kode undangan" saat daftar sebagai staff, tanpa perlu owner
    // expose seluruh isi /users/{uid} miliknya ke calon staff yang belum
    // jadi anggota workspace-nya. Isinya cuma penanda "uid ini valid owner",
    // dibuat sekali otomatis lewat createOwnerProfile, tidak pernah diubah.
    match /owner_codes/{ownerId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == ownerId;
      allow update, delete: if false;
    }

    // Kotak masukan "Beri Feedback" di ProfileScreen — bukan data bisnis
    // satu workspace, jadi di luar /workspaces. Sengaja cuma create: belum
    // ada UI admin buat baca balik lewat app, dicek langsung dari Firebase
    // Console, dan sekali terkirim tidak boleh diubah/dihapus oleh siapa pun.
    match /app_feedback/{feedbackId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /workspaces/{ownerId} {
      match /categories/{categoryId} {
        allow read, create: if isMemberOfWorkspace(ownerId);
        allow update, delete: if isMemberOfWorkspace(ownerId) && isOwnerRole();
      }

      match /transactions/{transactionId} {
        allow read, create: if isMemberOfWorkspace(ownerId);
        allow update, delete: if isMemberOfWorkspace(ownerId) && isOwnerRole();
      }

      // Riwayat Aktivitas: catatan aksi add/update/delete, ditulis otomatis
      // oleh TransactionCubit/CategoryCubit setelah aksi utamanya sukses.
      // Immutable — sekali tercatat tidak boleh diubah/dihapus siapa pun,
      // supaya tetap bisa dipercaya sebagai jejak aktivitas.
      match /activity_logs/{logId} {
        allow read, create: if isMemberOfWorkspace(ownerId);
        allow update, delete: if false;
      }
    }
  }
}
